{
  "name": "bonusfinder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:fts": "prisma db execute --file prisma/fts_setup.sql --schema prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:scrape": "tsx src/scrapers/run.ts",
    "db:recategorize": "tsx src/scrapers/recategorize.ts",
    "db:categories:audit": "tsx src/scrapers/categories-audit.ts",
    "db:purge-store": "tsx src/scrapers/purge-store.ts",
    "db:translate": "tsx src/scrapers/translate-run.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "//overrides": "Pin the two transitive packages flagged High by npm audit to their patched versions. Next 15 ships older ranges and npm's only auto-fix is the Next 16 major; these overrides close the advisories without that upgrade. Revisit/remove when moving to Next 16.",
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@clerk/nextjs": "^6.12.0",
    "@clerk/ui": "^1.26.1",
    "@next/third-parties": "^15.5.23",
    "@prisma/client": "^6.5.0",
    "@tanstack/react-query": "^5.66.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.23",
    "prisma": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.7.0"
  }
}
